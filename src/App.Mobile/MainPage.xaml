<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App.Mobile.MainPage"
             BackgroundColor="#F6F8FB"
             SafeAreaEdges="Container">

    <ContentPage.Resources>
        <Style x:Key="ToolbarIconButton" TargetType="ImageButton">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="WidthRequest" Value="44" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Aspect" Value="AspectFit" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="toolbarRow" Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="toolbarGrid"
              Grid.Row="0"
              Padding="8,6"
              ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto"
              BackgroundColor="#0F172A">
            <ImageButton x:Name="backButton"
                         Grid.Column="0"
                         Source="ic_nav_back.svg"
                         Style="{StaticResource ToolbarIconButton}"
                         SemanticProperties.Description="Volver"
                         Clicked="OnBackClicked" />
            <ImageButton x:Name="forwardButton"
                         Grid.Column="1"
                         Source="ic_nav_forward.svg"
                         Style="{StaticResource ToolbarIconButton}"
                         SemanticProperties.Description="Avanzar"
                         Clicked="OnForwardClicked" />
            <ImageButton Grid.Column="2"
                         Source="ic_nav_home.svg"
                         Style="{StaticResource ToolbarIconButton}"
                         SemanticProperties.Description="Ir al inicio"
                         Clicked="OnHomeClicked" />
            <Image x:Name="brandImage"
                   Grid.Column="3"
                   Source="serioustech_mark.svg"
                   HeightRequest="34"
                   WidthRequest="34"
                   Margin="4,0,8,0"
                   VerticalOptions="Center"
                   Aspect="AspectFit"
                   SemanticProperties.Description="SeriousTech" />
            <VerticalStackLayout Grid.Column="4"
                                 Padding="2,0"
                                 VerticalOptions="Center"
                                 Spacing="0">
                <Label x:Name="titleLabel"
                       Text="Serious Seguros"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="15"
                       LineBreakMode="TailTruncation" />
                <Label x:Name="environmentLabel"
                       Text="Portal seguro"
                       TextColor="#CBD5E1"
                       FontSize="11" />
            </VerticalStackLayout>
            <ImageButton Grid.Column="5"
                         Source="ic_nav_company.svg"
                         Style="{StaticResource ToolbarIconButton}"
                         SemanticProperties.Description="Cambiar empresa"
                         Clicked="OnChangeCompanyClicked" />
            <ImageButton Grid.Column="6"
                         Source="ic_nav_reload.svg"
                         Style="{StaticResource ToolbarIconButton}"
                         SemanticProperties.Description="Recargar"
                         Clicked="OnReloadClicked" />
        </Grid>

        <Grid Grid.Row="1">
            <WebView x:Name="portalWebView"
                     Navigating="OnPortalNavigating"
                     Navigated="OnPortalNavigated" />

            <Grid x:Name="loadingOverlay"
                  BackgroundColor="#EFFFFFFF"
                  InputTransparent="False">
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="12">
                    <ActivityIndicator IsRunning="True"
                                       Color="#175CD3"
                                       HeightRequest="36"
                                       WidthRequest="36" />
                    <Label x:Name="loadingMessageLabel"
                           Text="Conectando con el portal…"
                           TextColor="#334155"
                           FontSize="14" />
                </VerticalStackLayout>
            </Grid>

            <Grid x:Name="errorOverlay"
                  IsVisible="False"
                  Padding="28"
                  BackgroundColor="#F6F8FB">
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     MaximumWidthRequest="420"
                                     Spacing="14">
                    <Label Text="No pudimos abrir el portal"
                           HorizontalTextAlignment="Center"
                           TextColor="#0F172A"
                           FontAttributes="Bold"
                           FontSize="22" />
                    <Label x:Name="errorMessageLabel"
                           Text="Revisa tu conexión e inténtalo nuevamente."
                           HorizontalTextAlignment="Center"
                           TextColor="#475569"
                           FontSize="14" />
                    <Button Text="Reintentar"
                            Margin="0,8,0,0"
                            Padding="22,12"
                            BackgroundColor="#175CD3"
                            TextColor="White"
                            CornerRadius="8"
                            Clicked="OnRetryClicked" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
